# ── LLM API 配置 ─────────────────────────────────
# DeepSeek（或任意 OpenAI 兼容服务）
LLM_API_KEY=改成你的APIKey
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# ── Embedding 配置（RAG 检索用，必填）────────────────
# DeepSeek 不提供 embedding 接口，需单独配置一个 OpenAI 兼容的 embedding 服务
# （如硅基流动 SiliconFlow / 智谱 / OpenAI）。
# EMBEDDING_MODEL 示例：硅基流动 "BAAI/bge-m3"、OpenAI "text-embedding-3-small"
EMBEDDING_API_KEY=改成你的Embedding服务Key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ── 应用密钥（务必改成随机字符串）─────────────────
SECRET_KEY=改成一段随机字符串
JWT_SECRET_KEY=改成另一段随机字符串

# ── MySQL 数据库 ──────────────────────────────────
# 注意：MYSQL_HOST / REDIS_URL 会被 docker-compose 覆盖成容器内网地址，
# 这里保留 localhost 即可。MYSQL_PASSWORD 必须与 docker-compose 里
# ${MYSQL_PASSWORD} 读到的一致（也就是本文件里的值）。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=daa
MYSQL_PASSWORD=改成你的数据库密码
MYSQL_DATABASE=data_analysis_agent

# MySQL root 密码（docker-compose 用 ${MYSQL_ROOT_PASSWORD} 读取）
MYSQL_ROOT_PASSWORD=改成你的root密码

# ── Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB（嵌入式，数据落在 ./chroma_data，无需改）──────────
CHROMA_PERSIST_DIR=./chroma_data
