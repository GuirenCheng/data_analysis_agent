# ── LLM API 配置 ─────────────────────────────────
# DeepSeek（或任意 OpenAI 兼容服务）
LLM_API_KEY=改成你的APIKey
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# ── Embedding 配置（RAG 检索用，必填）────────────────
# DeepSeek 不提供 embedding 接口，需单独配置一个 OpenAI 兼容的 embedding 服务
# （如硅基流动 SiliconFlow / 智谱 / OpenAI）。
# EMBEDDING_MODEL 示例：硅基流动 "BAAI/bge-m3"、OpenAI "text-embedding-3-small"
EMBEDDING_API_KEY=改成你的Embedding服务Key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# bge 系列查询侧指令前缀（用于检索对齐，文档侧不加）；留空则不加
EMBEDDING_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:

# ── Rerank 配置（RAG 检索后二次精排，可选但强烈建议开启）────────
# 稠密向量的余弦相似度基线偏高（无关内容也 0.6+），单靠阈值无法区分相关/无关；
# 用交叉编码器 reranker 对候选重新打分，能真正拉开差距。
# 走 SiliconFlow 的 /v1/rerank 接口，RERANK_API_KEY/BASE_URL 留空则回退到
# 上面的 EMBEDDING_API_KEY / EMBEDDING_BASE_URL。
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_API_KEY=留空则回退 EMBEDDING_API_KEY
# RERANK_BASE_URL=留空则回退 EMBEDDING_BASE_URL
# rerank 相关性分数阈值：低于此值的候选被丢弃（交叉编码器分数比余弦可靠）
RERANK_THRESHOLD=0.3
# 每个内容类型召回的候选数（越多召回越全、rerank 成本越高）
RERANK_CANDIDATE_N=30

# ── 混合检索（稠密向量 + 词法召回）────────────────
# 稠密召回有语义天花板（跨语言/罕见词/字面重叠），词法召回用 jieba 分词后
# 做子串匹配补上「字面命中」的文档，最终交给 reranker 精排。
HYBRID_RETRIEVAL_ENABLED=true
# 每个关键词、每个内容类型的词法召回上限
LEXICAL_RECALL_K=20
# 词法召回的关键词上限（分词后按词长降序取前 N 个）
LEXICAL_MAX_KEYWORDS=8
# rerank 前候选池总量上限（稠密召回优先保留，词法命中补到上限）
RERANK_MAX_CANDIDATES=200

# RAG 相似度阈值：rerank 关闭/失败时的回退硬过滤阈值（0.5 = 50%）
RAG_SIMILARITY_THRESHOLD=0.5

# ── 应用密钥（务必改成随机字符串）─────────────────
SECRET_KEY=改成一段随机字符串
JWT_SECRET_KEY=改成另一段随机字符串

# ── MySQL 数据库 ──────────────────────────────────
# 注意：MYSQL_HOST / REDIS_URL 会被 docker-compose 覆盖成容器内网地址，
# 这里保留 localhost 即可。MYSQL_PASSWORD 必须与 docker-compose 里
# ${MYSQL_PASSWORD} 读到的一致（也就是本文件里的值）。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=daa
MYSQL_PASSWORD=改成你的数据库密码
MYSQL_DATABASE=data_analysis_agent

# MySQL root 密码（docker-compose 用 ${MYSQL_ROOT_PASSWORD} 读取）
MYSQL_ROOT_PASSWORD=改成你的root密码

# ── Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB（嵌入式，数据落在 ./chroma_data，无需改）──────────
CHROMA_PERSIST_DIR=./chroma_data
